# Copy to .env and fill in. Never commit real keys.
OPENAI_API_KEY=

# Anthropic Messages API — powers the 'anthropic' MT provider (claude-haiku-4-5).
ANTHROPIC_API_KEY=

# ElevenLabs — powers the 'elevenlabs' TTS provider and the 'elevenlabs' STT
# (Scribe realtime) provider.
#
# KEY SCOPES MATTER. The key currently in use is TTS-scoped only, so:
#   - speech_to_text — REQUIRED for the 'elevenlabs' STT provider. Without it
#     the Scribe realtime websocket handshake fails with HTTP 401 even though
#     the same key works fine for TTS. If you see a 401 from STT but not TTS,
#     this is why: widen the key's scope in the ElevenLabs dashboard.
#   - user_read — REQUIRED for the outstanding billing/quota verification
#     (reading the subscription + character usage endpoints). Also 401s without
#     it. Not needed for synthesis or transcription themselves.
ELEVENLABS_API_KEY=
